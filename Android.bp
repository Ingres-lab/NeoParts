android_app {
    name: "NeoParts",

    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.preference_preference",
    ],

    optimize: {
        enabled: false,
    },

    required: ["privapp_whitelist_org.neo.parts"],
}

prebuilt_etc {
    name: "privapp_whitelist_org.neo.parts",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_org.neo.parts.xml",
    filename_from_src: true,
}
