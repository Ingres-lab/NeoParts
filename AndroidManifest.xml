<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.neo.parts">

    <!-- Restart after switching the Vulkan driver -->
    <uses-permission android:name="android.permission.REBOOT" />

    <!-- Ringing state for the call light (sys.neo.led.call) -->
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />

    <!-- Neo wallpaper on the first boot (WallpaperInitReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Always-on display modes (AodController) own Settings.Secure.DOZE_ALWAYS_ON; the
         schedule alarm must fire in deep Doze -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Logs page: asks Android for a full bug report (the app is also named in sysconfig) -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Haptics page: plays the feel-test effects -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LauncherHaptics: launcher/ENABLE_SEARCH_HAPTIC_HINT -->
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Shoulder trigger overlay: floating button and editor over games (signature
         permission, granted to the platform-signed app); the editor collapses the shade -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- StatusBarManager.collapsePanels() when the trigger editor opens from the QS tile -->
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <!-- Color accuracy also selects the sRGB display color mode -->
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_COLOR_TRANSFORMS" />
    <!-- Keeps the trigger bubble visible over apps that hide non-system overlays (Files) -->
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />

    <!-- Tools > Play Integrity: download pif.json, restart DroidGuard to apply it;
         Tools > Pixel features lists Google apps without a launcher icon (Gboard) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Gestures > Three-finger screenshot: a gesture input monitor that can cancel the touch it
         takes over, and SystemUI's screenshot service (both signature permissions) -->
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="com.android.systemui.permission.SELF" />
    <!-- Gaming > Game performance: watch the focused app (TaskStackListener, getFocusedRootTaskInfo) -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <!-- ScreenshotHelper binds SystemUI's screenshot service as UserHandle.CURRENT -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />

    <!-- Tools > Hide developer options restarts an app after its setting changes -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />

    <!-- Smooth motion video lists the launcher apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NeoApplication"
        android:persistent="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_neo"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <activity
            android:name=".NeoSettingsActivity"
            android:label="@string/neo_title"
            android:exported="true"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_system_info_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-25" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/neo_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/neo_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_neo" />
            <meta-data
                android:name="com.android.settings.icon_color_scheme"
                android:value="purple" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <!-- Neo home entries open their page here (extra "page") -->
        <activity
            android:name=".NeoPageActivity"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".GameModeActivity"
            android:label="@string/gamemode_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".TriggerSettingsActivity"
            android:label="@string/trigger_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".PlayIntegrityActivity"
            android:label="@string/pif_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".PixelFeaturesActivity"
            android:label="@string/pixel_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".HideDevOptionsActivity"
            android:label="@string/hidedev_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".LogsSettingsActivity"
            android:label="@string/logs_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <!-- Shares the bug report zip from the cache through the share sheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.neo.parts.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".HapticsSettingsActivity"
            android:label="@string/haptics_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".SmoothMotionActivity"
            android:label="@string/smooth_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <!-- Also listed in Settings > Display > Lock screen, next to the stock AOD switch -->
        <activity
            android:name=".AodSettingsActivity"
            android:label="@string/aod_title"
            android:exported="true"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.lockscreen" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/aod_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/aod_summary" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <activity
            android:name=".MonetSettingsActivity"
            android:label="@string/monet_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".LightsSettingsActivity"
            android:label="@string/lights_title"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />

        <service
            android:name=".TriggerOverlayService"
            android:exported="false" />

        <service
            android:name=".TriggerTileService"
            android:label="@string/trigger_tile_label"
            android:icon="@drawable/ic_trigger"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".WallpaperInitReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
