    <!-- SELinux -->
    <string name="selinux_title">SELinux enforcing</string>
    <string name="selinux_summary_enforcing">Enforcing. Changes apply at once and persist across reboots.</string>
    <string name="selinux_summary_permissive">Permissive. Changes apply at once and persist across reboots.</string>
    <string name="selinux_dialog_title">Switch to Permissive?</string>
    <string name="selinux_dialog_message">Permissive mode disables Android\'s security policy. Apps and services are no longer confined, so a compromised app can access data and hardware it normally cannot. This setting stays on across reboots until you turn enforcing back on.</string>
    <string name="selinux_dialog_confirm">Switch to Permissive</string>
