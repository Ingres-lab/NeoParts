    <!-- Bypass charging -->
    <string name="bypass_charging_title">Bypass charging</string>
    <string name="bypass_charging_summary">Run the phone from the charger and stop charging the battery. The firmware only holds the battery at 80% or above.</string>

    <!-- Live battery monitor. Current is shown as flow into the battery. -->
    <string name="battery_monitor_title">Battery current</string>
