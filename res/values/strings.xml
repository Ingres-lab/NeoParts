    <string name="gpu_summary_format">%1$s. %2$s.</string>
    <string name="gpu_dialog_title">Switch to Mesa Turnip?</string>
    <string name="gpu_dialog_message">Turnip replaces the Vulkan driver for the whole system, including the UI renderer, not only for games. If the screen does not draw after the restart, switch back over adb:\n\nadb shell setprop persist.sys.neo.gpu adreno\nadb reboot</string>
    <string name="gpu_dialog_confirm">Switch</string>
