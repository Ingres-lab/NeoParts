    <string name="bypass_state_unplugged">Bypass is on. Connect a charger to run the phone from it.</string>
    <string name="bypass_state_working">Bypass is working: the phone runs from the charger and the battery is idle.</string>
    <string name="bypass_state_filling">Charging to 80% first; bypass then holds the battery.</string>
    <string name="bypass_state_not_holding">Bypass is on but the battery is still charging above 80%. Bypass is not taking effect.</string>
    <string name="bypass_state_draining">The phone draws more than the charger supplies; the battery covers the difference.</string>

    <!-- GPU driver -->
    <string name="gpu_turnip_title">Mesa Turnip Vulkan driver</string>
    <string name="gpu_active_turnip">Active: Mesa Turnip</string>
    <string name="gpu_active_adreno">Active: Qualcomm (stock)</string>
