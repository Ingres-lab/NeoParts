<!-- Neo home: grouped entries with coloured icons, laid out like the Settings homepage.
     Untitled categories only split the rounded cards. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/neo_title">

    <PreferenceCategory android:key="group_device">
        <Preference
            android:key="battery"
            android:icon="@drawable/ic_neo_home_battery"
            android:title="@string/page_battery_title"
            android:summary="@string/page_battery_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="battery" />
            </intent>
        </Preference>
        <Preference
            android:key="display"
            android:icon="@drawable/ic_neo_home_display"
            android:title="@string/category_display"
            android:summary="@string/page_display_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="display" />
            </intent>
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:key="group_play">
        <Preference
            android:key="gaming"
            android:icon="@drawable/ic_neo_home_gaming"
            android:title="@string/category_gaming"
            android:summary="@string/page_gaming_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="gaming" />
            </intent>
        </Preference>
        <Preference
            android:key="haptics"
            android:icon="@drawable/ic_neo_home_haptics"
            android:title="@string/haptics_title"
            android:summary="@string/page_haptics_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.HapticsSettingsActivity" />
        </Preference>
        <Preference
            android:key="gestures"
            android:icon="@drawable/ic_neo_home_gestures"
            android:title="@string/category_gestures"
            android:summary="@string/page_gestures_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="gestures" />
            </intent>
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:key="group_media">
        <Preference
            android:key="graphics"
            android:icon="@drawable/ic_neo_home_graphics"
            android:title="@string/page_graphics_title"
            android:summary="@string/page_graphics_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="graphics" />
            </intent>
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:key="group_system">
        <Preference
            android:key="security"
            android:icon="@drawable/ic_neo_home_security"
            android:title="@string/page_security_title"
            android:summary="@string/page_security_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.NeoPageActivity">
                <extra android:name="page" android:value="security" />
            </intent>
        </Preference>
        <Preference
            android:key="logs"
            android:icon="@drawable/ic_neo_home_logs"
            android:title="@string/page_logs_title"
            android:summary="@string/page_logs_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.LogsSettingsActivity" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
