<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/neo_title">

    <PreferenceCategory
        android:key="category_charging"
        android:title="@string/category_charging">

        <SwitchPreferenceCompat
            android:key="bypass_charging"
            android:persistent="false"
            android:title="@string/bypass_charging_title"
            android:summary="@string/bypass_charging_summary" />

        <Preference
            android:key="battery_monitor"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/battery_monitor_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_display"
        android:title="@string/category_display">

        <Preference
            android:key="aod"
            android:title="@string/aod_title"
            android:summary="@string/aod_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.AodSettingsActivity" />
        </Preference>

        <SwitchPreferenceCompat
            android:key="color_accuracy"
            android:persistent="false"
            android:title="@string/flat_title"
            android:summary="@string/flat_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_gaming"
        android:title="@string/category_gaming">

        <Preference
            android:key="shoulder_triggers"
            android:title="@string/trigger_title"
            android:summary="@string/trigger_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.TriggerSettingsActivity" />
        </Preference>

        <Preference
            android:key="rear_lights"
            android:title="@string/lights_title"
            android:summary="@string/lights_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.LightsSettingsActivity" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_video"
        android:title="@string/category_video">

        <Preference
            android:key="smooth_motion"
            android:title="@string/smooth_title"
            android:summary="@string/smooth_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.SmoothMotionActivity" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_graphics"
        android:title="@string/category_graphics">

        <SwitchPreferenceCompat
            android:key="gpu_turnip"
            android:persistent="false"
            android:title="@string/gpu_turnip_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_security"
        android:title="@string/category_security">

        <SwitchPreferenceCompat
            android:key="selinux_enforcing"
            android:persistent="false"
            android:title="@string/selinux_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_tools"
        android:title="@string/category_tools">

        <Preference
            android:key="hide_devopts"
            android:title="@string/hidedev_title"
            android:summary="@string/hidedev_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.HideDevOptionsActivity" />
        </Preference>

        <Preference
            android:key="play_integrity"
            android:title="@string/pif_title"
            android:summary="@string/pif_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.PlayIntegrityActivity" />
        </Preference>

        <Preference
            android:key="pixel_features"
            android:title="@string/pixel_title"
            android:summary="@string/pixel_summary">
            <intent
                android:targetPackage="org.neo.parts"
                android:targetClass="org.neo.parts.PixelFeaturesActivity" />
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
